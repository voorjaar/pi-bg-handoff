+/**
+ * pi-bg-handoff fork: this fork's PI_BG_FEATURES default is `process` only, but several upstream
+ * suites exercise the optional delegate/fusion/attested surfaces and assume the full surface is
+ * available. Those suites pin this set explicitly instead of relying on the default.
+ */
+export const FULL_FEATURES = 'process,delegate,fusion,attested,attribution';
+
+export function pinFullFeatureDefault(): void {
+  process.env['PI_BG_FEATURES'] ??= FULL_FEATURES;
+}
+
+/**
+ * This fork defaults PI_BG_FOOTER_HINTS to `off`, so the footer advertises nothing beyond task state.
+ * Suites that assert the advertised dock-entry and `/bg-clear` hints opt in here.
+ */
+export const FOOTER_HINTS_ON = 'on';
+
+export function pinFooterHintsOn(): void {
+  process.env['PI_BG_FOOTER_HINTS'] ??= FOOTER_HINTS_ON;
+}
