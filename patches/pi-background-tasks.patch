+      assert.ok(third?.waitingOn === second?.id, 'a queued member becomes the new queue head');
+      assert.equal(h.children.length, 1, 'only the head may run');
+
+      lastSpawn(h).child.close(0, null);
+      await waitFor(() => h.children.length === 2, 'second released by the head terminal');
+      assert.equal(h.registry.allTasks().find((task) => task.id === second?.id)?.status, 'running');
+      assert.equal(h.children.length, 2, 'the third still waits behind the second');
+
+      lastSpawn(h).child.close(0, null);
+      await waitFor(() => h.children.length === 3, 'third released in order');
+      assert.equal(h.registry.allTasks().find((task) => task.id === third?.id)?.status, 'running');
+    } finally {
+      h.registry.setShuttingDown(true);
+      await cleanup(h.root);
+    }
+  });
+
+  void it('starts immediately when the dependency is already terminal and rejects an unknown id', async () => {
+    const h = await createHarness();
+    try {
+      const done = await h.registry.startTask(h.ctx, 'echo done', { name: 'Done', ...quiet });
+      lastSpawn(h).child.close(0, null);
+      await waitFor(() => done.status === 'completed', 'dependency completed');
+      const now = await h.registry.queueTask(h.ctx, 'echo next', {
+        name: 'Next',
+        ...quiet,
+        afterTaskId: done.id,
+      });
+      assert.equal(now, null, 'a finished dependency is nothing to wait for');
+
+      await assert.rejects(
+        () => h.registry.queueTask(h.ctx, 'echo lost', { name: 'Lost', ...quiet, afterTaskId: 'nosuchtask' }),
+        /afterTaskId nosuchtask does not match any background task/u,
+      );
+      assert.equal(h.children.length, 1, 'a rejected queue call must not spawn anything');
+    } finally {
+      h.registry.setShuttingDown(true);
+      await cleanup(h.root);
+    }
+  });
+
+  void it('cancelling a queued head releases what waited behind it', async () => {
+    const h = await createHarness();
+    try {
+      const first = await h.registry.startTask(h.ctx, 'echo first', { name: 'First', ...quiet });
+      const middle = await h.registry.queueTask(h.ctx, 'echo middle', {
+        name: 'Middle',
+        ...quiet,
+        afterTaskId: first.id,
+      });
+      const last = await h.registry.queueTask(h.ctx, 'echo last', {
+        name: 'Last',
+        ...quiet,
+        afterTaskId: middle?.id,
+      });
+      assert.equal(h.children.length, 1);
+      const cancelled = h.registry.cancelQueuedTask(middle?.id ?? '', 'user cancel');
+      assert.ok(cancelled);
+      assert.equal(cancelled.status, 'queued');
+      assert.equal(h.registry.queuedTask(middle?.id ?? ''), undefined);
+      await waitFor(() => h.children.length === 2, 'the task behind a cancelled head is released');
+      const released = h.registry.allTasks().find((task) => task.id === last?.id);
+      assert.ok(released, 'the released task carries the announced id');
+      assert.equal(released.status, 'running');
+    } finally {
+      h.registry.setShuttingDown(true);
+      for (const { child } of h.children) {
+        if (child.listenerCount('close') > 0) child.close(null, 'SIGTERM');
+      }
+      await cleanup(h.root);
+    }
+  });
