+ * Unambiguous boolean spellings a model can emit for a tool argument.
+ *
+ * Tool call arguments are provider-generated JSON, and providers/harnesses routinely emit
+ * Python-style booleans (False) or quote the literal ('false'). Pi calls a tool's
+ * `prepareArguments` on the raw call arguments before schema validation, which is the one place
+ * that can normalize them, so these spellings are accepted and everything ambiguous is not.
+ */
+const COERCIBLE_BOOLEAN_SPELLINGS = new Map<string, boolean>([
+  ['true', true],
+  ['false', false],
+  ['1', true],
+  ['0', false],
+]);
+
+/** Normalize an unambiguous boolean spelling. Anything unusable yields `undefined`. */
+export function coerceToolBooleanArgument(value: unknown): boolean | undefined {
+  if (typeof value === 'boolean') return value;
+  if (typeof value === 'number') return value === 1 ? true : value === 0 ? false : undefined;
+  if (typeof value !== 'string') return undefined;
+  return COERCIBLE_BOOLEAN_SPELLINGS.get(stripMatchingQuotes(value).trim().toLowerCase());
